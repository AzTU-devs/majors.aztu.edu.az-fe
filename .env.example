# Copy to .env.local for development. All values have production defaults.

# Public origin of this site. Drives canonical URLs, hreflang, sitemap and OG tags.
# Inlined at build time.
NEXT_PUBLIC_SITE_URL=https://majors.aztu.edu.az

# Majors API. Point at http://127.0.0.1:8000 to develop against a local backend.
# Inlined at build time, and also used for the Content-Security-Policy
# connect-src in next.config.ts — rebuild after changing it.
NEXT_PUBLIC_API_BASE_URL=https://api-majors.aztu.edu.az

# How long (seconds) server-rendered pages may reuse an API answer. Admin
# edits and deletions appear on the public site within this window.
# Default 60; 0 disables the cache.
API_REVALIDATE_SECONDS=60
