# Copy to .env.local for development. Every value has a production-safe default,
# so the app runs without this file.

# Public origin of this site. Drives canonical URLs, hreflang, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=https://majors.aztu.edu.az

# Majors API. Point at http://127.0.0.1:8000 to develop against a local backend.
NEXT_PUBLIC_API_BASE_URL=https://api-majors.aztu.edu.az

# Password gate.
#   on  (default) — the whole site is behind /unlock, and robots.txt disallows
#                   everything. Search engines cannot index the site.
#   off           — the site is public; robots.txt opens up and the sitemap is
#                   populated. Set this when the site is ready to launch.
SITE_GATE=on

# Gate credentials (only used while SITE_GATE=on).
SITE_PASSWORD=change-me
SITE_GATE_TOKEN=change-me-to-a-random-hex-string
